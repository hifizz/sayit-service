# Run npm run setup to generate a private .env with a random service token.
NODE_ENV=development
SAYIT_MODE=mock
SAYIT_SERVICE_TOKEN=GENERATE_WITH_NPM_RUN_SETUP
HOST=127.0.0.1
PORT=8787
# Empty means volatile development storage. Production MUST use PostgreSQL.
DATABASE_URL=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_STT_MODEL=grok-voice-transcribe-2.0
# Cleanup/rewrite baseline. Put the real relay URL and key only in your private .env.
# The repository intentionally does not guess or commit your private New API endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://replace-with-your-new-api-host.example/v1
LLM_MODEL=glm-5.3-flash
LLM_JSON_MODE=json_object
RETENTION_HOURS=168
MAX_AUDIO_BYTES=26214400
MAX_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT=16
